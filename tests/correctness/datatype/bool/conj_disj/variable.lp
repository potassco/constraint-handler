variable_declare(x,fromFacts).
variable_domain(x,val(bool,false)).
variable_domain(x,val(bool,true)).
variable_domain(x,bad).
evaluate(operation(conj,(variable(x),(val(bool,false),())))).
evaluate(operation(conj,(variable(x),(val(bool,true),())))).
evaluate(operation(conj,(variable(x),(bad,())))).
evaluate(operation(disj,(variable(x),(val(bool,false),())))).
evaluate(operation(disj,(variable(x),(val(bool,true),())))).
evaluate(operation(disj,(variable(x),(bad,())))).
